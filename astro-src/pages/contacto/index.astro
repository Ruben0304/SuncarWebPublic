---
import SiteLayout from "~/layouts/SiteLayout.astro";
import Formulario from "~/components/contacto/Formulario.svelte";
import Mapa from "~/components/contacto/Mapa.svelte";
import Clock from "lucide-svelte/icons/clock";
import Mail from "lucide-svelte/icons/mail";
import MapPin from "lucide-svelte/icons/map-pin";
import Phone from "lucide-svelte/icons/phone";
import { obtenerContacto } from "@/lib/contacto";

// Dirección, teléfono y correo salen del servidor (caché de una hora, con
// respaldo si la API cae): van en el HTML y el formulario recibe el WhatsApp.
const contacto = await obtenerContacto();

const datos = [
  { Icono: MapPin, titulo: "Oficina Principal", contenido: contacto.direccion, color: "bg-[#012928]" },
  { Icono: Phone, titulo: "Teléfono", contenido: contacto.telefono, color: "bg-secondary-gradient" },
  { Icono: Mail, titulo: "Email", contenido: contacto.correo, color: "bg-[#012928]" },
  {
    Icono: Clock,
    titulo: "Horarios",
    contenido: "Lun - Vie: 8:00 AM - 6:00 PM\nSáb: 9:00 AM - 2:00 PM",
    color: "bg-secondary-gradient",
  },
];
---

<SiteLayout
  title="Contacto - Asistencia y Soporte"
  description="Contacta con Suncar Cuba para consultas sobre energía solar, soporte técnico y asesoramiento. Estamos en La Habana para solucionar tus problemas eléctricos con paneles solares y baterías."
  path="/contacto"
>
  <section class="relative py-20 lg:py-24 bg-primary overflow-hidden">
    <div class="container mx-auto px-4 md:px-6 lg:px-8">
      <div class="text-center text-white space-y-6" style="margin-top: 100px;">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          <span class="block animate-fade-in-up">Hablemos Sobre</span>
          <span class="block bg-secondary-gradient bg-clip-text text-transparent animate-fade-in-up animation-delay-200">
            Tu Proyecto Solar
          </span>
        </h1>
        <p class="text-lg lg:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed animate-fade-in-up animation-delay-400">
          Nuestro equipo de expertos está listo para ayudarte a transformar tu hogar con energía solar limpia y renovable
        </p>
      </div>
    </div>

    <div class="absolute top-20 left-10 w-2 h-2 bg-white/30 rounded-full animate-bounce animation-delay-1000"></div>
    <div class="absolute top-40 right-20 w-3 h-3 bg-white/20 rounded-full animate-bounce animation-delay-1200"></div>
    <div class="absolute bottom-40 left-20 w-1 h-1 bg-white/40 rounded-full animate-bounce animation-delay-800"></div>
  </section>

  <section class="py-16 lg:py-20 bg-[#F2F2EF]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <Formulario whatsapp={contacto.whatsapp} client:visible />

        <div class="space-y-8">
          <div>
            <h2 class="text-2xl lg:text-3xl font-bold text-primary mb-4">Información de Contacto</h2>
            <p class="text-gray-600 leading-relaxed">
              Estamos aquí para ayudarte en cada paso hacia la independencia energética. Contáctanos por cualquiera de estos medios.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-1 gap-6">
            {datos.map(({ Icono, titulo, contenido, color }) => (
              <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105">
                <div class="flex items-start gap-4">
                  <div class={`${color} p-3 rounded-lg text-white flex-shrink-0`}>
                    <Icono class="w-6 h-6" />
                  </div>
                  <div>
                    <h3 class="font-semibold text-primary mb-2">{titulo}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed whitespace-pre-line">{contenido}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-[#F2F2EF]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl lg:text-3xl font-bold text-primary mb-4">Nuestra Ubicación</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Visítanos en nuestra oficina principal en La Habana. Estamos ubicados estratégicamente para brindarte el mejor servicio.
        </p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <Mapa lat={23.129769} lng={-82.414698} address={contacto.direccion} height="500px" client:visible />
      </div>

      <div class="mt-8 text-center">
        <div class="inline-flex items-center gap-3 bg-gray-50 rounded-full px-6 py-3">
          <MapPin class="w-5 h-5 text-primary" />
          <span class="font-semibold text-primary">{contacto.direccion}</span>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
