---
import SiteLayout from "~/layouts/SiteLayout.astro";
import OfertasContent from "~/components/ofertas/OfertasContent.svelte";
import { obtenerOfertasPublicas } from "@/lib/ofertas/ofertas-publicas-server";

// Armar kit, recomendador con IA y listado: para SEO, cada kit tiene además su
// propia URL en /ofertas/[slug], y este listado entra al sitemap-ofertas.xml
// dinámico.
const initialOfertas = await obtenerOfertasPublicas();
const marcaParam = Astro.url.searchParams.get("marca");
const modoParam = Astro.url.searchParams.get("modo");
const kitParam = Astro.url.searchParams.get("kit");
---

<SiteLayout
  title="Kits solares completos"
  description="Arma tu kit fotovoltaico a medida o elegí uno de nuestros kits completos: inversor, batería y paneles, con financiamiento disponible en Cuba."
  path="/ofertas"
>
  <OfertasContent
    initialOfertas={initialOfertas}
    marcaParam={marcaParam}
    modoParam={modoParam}
    kitParam={kitParam}
    client:load
  />
</SiteLayout>
