---
export const prerender = true;
import SiteLayout from "~/layouts/SiteLayout.astro";
import Sun from "lucide-svelte/icons/sun";
import Target from "lucide-svelte/icons/target";
import Heart from "lucide-svelte/icons/heart";
import Award from "lucide-svelte/icons/award";
import CheckCircle from "lucide-svelte/icons/circle-check";
import Home from "lucide-svelte/icons/house";
import Building from "lucide-svelte/icons/building";
import Factory from "lucide-svelte/icons/factory";
import Sprout from "lucide-svelte/icons/sprout";
import ArrowRight from "lucide-svelte/icons/arrow-right";
import TrendingUp from "lucide-svelte/icons/trending-up";

// Mismas clases que antes: las que no existen en globals.css (p. ej. 2100ms)
// simplemente no aplican retraso, como en el original.
const d = (ms: number) => `animation-delay-${ms}`;

const targetAudiences = [
  {
    icon: Home,
    title: "Hogares Familiares",
    description: "Familias que desean independencia energética y ahorro económico ante los apagones.",
    features: [
      "Seguridad energética durante apagones",
      "Ahorro a largo plazo en electricidad",
      "Mejora de la calidad de vida",
      "Solución sostenible y duradera",
    ],
    color: "from-[#012928] to-[#023d3a]",
  },
  {
    icon: Building,
    title: "Pequeñas y Medianas Empresas",
    description: "Mipymes que requieren estabilidad eléctrica para operar: cafeterías, talleres, panaderías.",
    features: [
      "Eficiencia energética para el negocio",
      "Reducción de costos operativos",
      "Respaldo ante interrupciones eléctricas",
      "Mayor productividad empresarial",
    ],
    color: "from-[#F2C300] to-[#AFEB17]",
  },
  {
    icon: Factory,
    title: "Industrias de Alto Consumo",
    description: "Empresas con procesos que demandan gran carga energética (≥50 kVA).",
    features: [
      "Reducción de dependencia de la red",
      "Optimización operacional industrial",
      "Responsabilidad ambiental corporativa",
      "Ahorro significativo en energía",
    ],
    color: "from-[#012928] to-[#023d3a]",
  },
  {
    icon: Sprout,
    title: "Emprendedores Rurales",
    description: "Productores agrícolas, fincas y cooperativas que buscan autonomía energética.",
    features: [
      "Autonomía para maquinarias agrícolas",
      "Sistemas de riego independientes",
      "Refrigeración para productos",
      "Procesamiento sostenible",
    ],
    color: "from-[#F2C300] to-[#AFEB17]",
  },
];

const values = [
  {
    icon: Sun,
    title: "Sostenibilidad",
    description: "Implementamos soluciones energéticas donde la sostenibilidad es nuestra operativa diaria: limpia, consciente y orientada al futuro.",
  },
  {
    icon: CheckCircle,
    title: "Honestidad",
    description: "Guiados por la honestidad en cada estudio y solución que ofrecemos a nuestros clientes.",
  },
  {
    icon: Award,
    title: "Responsabilidad",
    description: "Compromiso con instalaciones precisas y mantenimiento permanente de todos nuestros sistemas.",
  },
  {
    icon: Heart,
    title: "Pasión",
    description: "Integramos tecnología y creatividad con pasión para evolucionar con las necesidades reales de Cuba.",
  },
];
---

<SiteLayout
  title="Sobre Nosotros - Especialistas en Energía Solar"
  description="Conoce a Suncar Cuba: más de 5 años transformando hogares y empresas con energía solar. Especialistas en soluciones al déficit energético con paneles solares, baterías y sistemas autónomos para familias y mipymes."
  path="/sobre-nosotros"
>
  <!-- Hero -->
  <section class="relative py-20 lg:py-24 bg-primary overflow-hidden">
    <div class="container mx-auto px-4 md:px-6 lg:px-8">
      <div class="text-center text-white space-y-6" style="margin-top: 100px">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          <span class="block text-reveal animation-delay-200">Sobre</span>
          <span class="block bg-secondary-gradient bg-clip-text text-transparent text-reveal animation-delay-400 attention-grabber">
            SUNCAR
          </span>
        </h1>
        <p class="text-lg lg:text-xl text-white/80 max-w-3xl mx-auto leading-relaxed animate-fade-in-up animation-delay-600">
          Instala el futuro. Somos una empresa cubana líder en soluciones de energía solar, descendiente de una compañía española con más de 5 años transformando hogares y negocios cubanos.
        </p>
      </div>
    </div>

    <div class="floating-decoration floating-decoration-1 w-4 h-4 morphing-shape opacity-30"></div>
    <div class="floating-decoration floating-decoration-2 w-6 h-6 morphing-shape opacity-20"></div>
    <div class="floating-decoration floating-decoration-3 w-3 h-3 morphing-shape opacity-40"></div>

    <div class="absolute top-20 left-10 w-2 h-2 bg-white/30 rounded-full animate-bounce-slow animation-delay-1000"></div>
    <div class="absolute top-40 right-20 w-3 h-3 bg-white/20 rounded-full animate-bounce-slow animation-delay-1200"></div>
    <div class="absolute bottom-40 left-20 w-1 h-1 bg-white/40 rounded-full animate-bounce-slow animation-delay-800"></div>
    <div class="absolute top-60 left-1/4 w-2 h-2 bg-secondary-gradient rounded-full animate-pulse-glow animation-delay-1400"></div>
    <div class="absolute bottom-60 right-1/3 w-4 h-4 bg-secondary-gradient rounded-full animate-pulse-glow animation-delay-1600"></div>
  </section>

  <!-- Quiénes somos -->
  <section class="py-16 lg:py-20 bg-[#F2F2EF]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center space-y-8">
        <div class="inline-block px-4 py-2 bg-[#012928] text-white text-sm font-semibold rounded-full mb-4">
          Quiénes Somos
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary mb-6">
          Construimos Sostenibilidad, Tecnología y Futuro
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed">
          Somos SUNCAR, una empresa cubana, descendiente de una compañía española con más de cinco años de experiencia en energías renovables. Ofrecemos soluciones integrales en energía solar para hogares y negocios, trabajando con marcas líderes que garantizan tecnología confiable, eficiente y segura.
        </p>
        <p class="text-lg text-gray-600 leading-relaxed">
          Nuestro equipo altamente capacitado y la cobertura nacional nos permiten brindar un servicio ágil y profesional en todo el país. Más que instalar sistemas, construimos sostenibilidad, tecnología y futuro. Nos distinguimos por la excelencia operativa, la atención personalizada y una visión clara: mejorar la calidad de vida mientras cuidamos del planeta.
        </p>
      </div>
    </div>
  </section>

  <!-- Misión y visión -->
  <section class="py-16 lg:py-20 bg-[#F2F2EF]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <div class="bg-white rounded-2xl p-8 shadow-xl hover-magnetic glow-on-hover animate-fade-in-left animation-delay-400">
          <div class="w-16 h-16 bg-gradient-to-br from-[#012928] to-[#023d3a] rounded-2xl flex items-center justify-center text-white mb-6 animate-pulse-glow animation-delay-600">
            <Target class="w-8 h-8 animate-rotate-slow" />
          </div>
          <h3 class="text-2xl font-bold text-primary mb-4 animate-fade-in-up animation-delay-800">Nuestra Misión</h3>
          <p class="text-gray-600 leading-relaxed animate-fade-in-up animation-delay-1000">
            Impulsar el uso de energías renovables en Cuba, conectando hogares y negocios con soluciones solares inteligentes, personalizadas y sostenibles; combinar tecnología, agilidad y excelencia operativa con el compromiso de colaboradores comprometidos, para ofrecer una experiencia única que transforme y eleve la calidad de vida de cada cliente.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-xl hover-magnetic glow-on-hover animate-fade-in-right animation-delay-400">
          <div class="w-16 h-16 bg-gradient-to-br from-[#F2C300] to-[#AFEB17] rounded-2xl flex items-center justify-center text-white mb-6 animate-pulse-glow animation-delay-800">
            <TrendingUp class="w-8 h-8" />
          </div>
          <h3 class="text-2xl font-bold text-primary mb-4 animate-fade-in-up animation-delay-1000">Nuestra Visión</h3>
          <p class="text-gray-600 leading-relaxed animate-fade-in-up animation-delay-1200">
            Establecer en Cuba soluciones solares inteligentes como inversión estratégica, transformando el gasto energético en rentabilidad para hogares y empresas. Encabezar el futuro energético a nivel nacional siendo líderes en soluciones renovables, inteligentes, accesibles y sostenibles.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="py-16 lg:py-20 bg-[#F2F2EF]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-block px-4 py-2 bg-[#012928] text-white text-sm font-semibold rounded-full mb-4">
          Nuestros Valores
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary mb-4">Los Principios Que Nos Guían</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          SUNCAR implementa soluciones energéticas con valores sólidos que definen nuestra forma de trabajo y compromiso con Cuba
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((value, index) => (
          <div class="text-center hover-magnetic">
            <div class={`w-20 h-20 bg-secondary-gradient rounded-2xl flex items-center justify-center text-white mx-auto mb-6 glow-on-hover animate-scale-in ${d(200 + index * 200)}`}>
              <value.icon class="w-12 h-12" />
            </div>
            <h3 class={`text-lg font-bold text-primary mb-3 animate-fade-in-up ${d(400 + index * 200)}`}>{value.title}</h3>
            <p class={`text-gray-600 text-sm leading-relaxed animate-fade-in-up ${d(600 + index * 200)}`}>{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Público objetivo -->
  <section class="py-16 lg:py-20 bg-[#F2F2EF]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-block px-4 py-2 bg-[#012928] text-white text-sm font-semibold rounded-full mb-4">
          Nuestros Clientes
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary mb-4">¿A Quién Servimos?</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Ofrecemos soluciones energéticas especializadas para diferentes sectores de la economía cubana
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {targetAudiences.map((audience, index) => (
          <div class={`bg-white rounded-2xl shadow-xl p-8 hover:shadow-2xl transition-all duration-300 hover-magnetic animate-scale-in ${d(800 + index * 300)}`}>
            <div class={`w-16 h-16 bg-gradient-to-br ${audience.color} rounded-2xl flex items-center justify-center text-white mb-6 glow-on-hover animate-wiggle ${d(1000 + index * 300)}`}>
              <audience.icon class="w-8 h-8" />
            </div>

            <h3 class={`text-xl font-bold text-primary mb-4 animate-fade-in-up ${d(1200 + index * 300)}`}>{audience.title}</h3>
            <p class={`text-gray-600 mb-6 leading-relaxed animate-fade-in-up ${d(1400 + index * 300)}`}>{audience.description}</p>

            <div class="space-y-3">
              {audience.features.map((feature, idx) => (
                <div class={`flex items-center gap-3 animate-fade-in-left ${d(1600 + index * 300 + idx * 100)}`}>
                  <CheckCircle class="w-5 h-5 text-[#012928] flex-shrink-0" />
                  <span class="text-sm text-gray-700">{feature}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto (el botón de cotización está deshabilitado temporalmente) -->
  <section class="py-16 lg:py-20 bg-[#F2F2EF]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto space-y-6">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary">
          ¿Quieres Formar Parte del Futuro Solar de Cuba?
        </h2>
        <p class="text-lg text-gray-600">
          Únete a las familias y empresas que ya confían en SUNCAR para su independencia energética
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-stretch sm:items-center">
          <a
            href="/contacto"
            class="w-full sm:w-auto px-8 py-4 bg-[#012928] text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center gap-2 hover-magnetic"
          >
            Contactar Ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Enlace a la información del sitio -->
  <section class="py-16 lg:py-20 bg-[#F2F2EF]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8 text-center">
      <div class="max-w-3xl mx-auto space-y-6">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary">
          ¿Quieres Conocer Más Sobre Este Sitio Web?
        </h2>
        <p class="text-lg text-gray-600">
          Descubre las tecnologías y el equipo detrás de este sitio web moderno
        </p>
        <div class="pt-4">
          <a
            href="/webinfo"
            class="group px-8 py-4 bg-[#012928] text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center gap-2 hover-magnetic glow-on-hover mx-auto w-fit"
          >
            Ver Información del Sitio Web
            <ArrowRight class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
